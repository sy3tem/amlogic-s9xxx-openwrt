#!/bin/sh /etc/rc.common
# /opt = the shared eMMC partition (p4, label EMMC_SHARED), R28S scheme with
# explicit EXT4:
#   1) grow p4 to the end of the disk (8G / 32G / 128G / 256G boards),
#   2) if the partition is still btrfs (ophub creates it that way) and empty,
#      reformat it as ext4 -- this happens on a fresh install; a partition that
#      already carries data is left untouched,
#   3) mount at /opt (fstab label entry is written by 99-n1-siderouter),
#   4) resize2fs to the new partition size.
# No bind mount, no symlink, no auto-mount of the spare rootfs slot.
START=98
STOP=10

label_dev() {
	blkid -L "$1" 2>/dev/null
}

grow_partition() {
	local rootpart disk diskname start dsz csz

	rootpart=$(awk '$2 == "/" { print $1; exit }' /proc/mounts)
	case "${rootpart}" in
		/dev/mmcblk*p*) ;;
		*) return 0 ;;
	esac

	disk="${rootpart%p*}"
	diskname="${disk##*/}"

	[ -b "${disk}p4" ] || return 0
	start=$(cat "/sys/class/block/${diskname}p4/start" 2>/dev/null)
	dsz=$(cat "/sys/class/block/${diskname}/size" 2>/dev/null)
	csz=$(cat "/sys/class/block/${diskname}p4/size" 2>/dev/null)
	[ -n "${start}" ] && [ -n "${dsz}" ] && [ -n "${csz}" ] || return 0

	[ "${dsz}" -gt $((start + csz)) ] || return 0

	logger -t optbind "growing p4: ${csz} -> $((dsz - start - 2048)) sectors"
	echo "start=${start}, size=$((dsz - start - 2048)), type=83" | \
		sfdisk -N 4 --force --no-reread "${disk}" >/dev/null 2>&1
	partx -u -n 4 "${disk}" >/dev/null 2>&1
	sync
	sleep 1
}

ensure_ext4() {
	local dev fstype chk entries

	dev=$(label_dev EMMC_SHARED)
	[ -n "${dev}" ] || return 0
	fstype=$(blkid -o value -s TYPE "${dev}" 2>/dev/null)

	[ "${fstype}" = "ext4" ] && return 0

	# ophub formats p4 as btrfs. Only replace it when it is empty, so an
	# existing data partition is never destroyed by an upgrade.
	chk=/tmp/.optchk
	mkdir -p "${chk}"
	if mount -o ro "${dev}" "${chk}" 2>/dev/null; then
		entries=$(ls -A "${chk}" 2>/dev/null | wc -l)
		umount "${chk}" 2>/dev/null
		if [ "${entries}" -eq 0 ]; then
			logger -t optbind "reformatting ${dev} (${fstype}) as ext4"
			mkfs.ext4 -F -L EMMC_SHARED "${dev}" >/dev/null 2>&1
		else
			logger -t optbind "${dev} is ${fstype} and not empty, left as is"
		fi
	else
		logger -t optbind "cannot mount ${dev} for inspection, left as is"
	fi
}

start() {
	i=0
	while [ "$i" -lt 30 ]; do
		label_dev EMMC_SHARED >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done
	label_dev EMMC_SHARED >/dev/null 2>&1 || return 0

	mkdir -p /opt
	if ! mountpoint -q /opt; then
		grow_partition
		ensure_ext4
		mount -L EMMC_SHARED /opt 2>/dev/null || return 0
	fi

	dev=$(label_dev EMMC_SHARED)
	if [ -n "${dev}" ] && [ "$(blkid -o value -s TYPE "${dev}" 2>/dev/null)" = "ext4" ]; then
		resize2fs "${dev}" >/dev/null 2>&1
	fi
}

stop() {
	umount /opt 2>/dev/null
}
