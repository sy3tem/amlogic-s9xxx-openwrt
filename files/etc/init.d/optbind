#!/bin/sh /etc/rc.common
# /opt = the shared eMMC partition (p4, label EMMC_SHARED).
#
# Same scheme as the R28S firmware:
#   * fstab carries a plain label based mount entry (99-n1-siderouter writes it),
#   * block-mount mounts it at boot; this service is only a safety net in case
#     the block event arrives late,
#   * no bind mount, no symlink, no auto-mount of the spare rootfs slot.
START=98
STOP=10

start() {
	i=0
	while [ "$i" -lt 30 ]; do
		blkid -L EMMC_SHARED >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done

	mkdir -p /opt
	mountpoint -q /opt || mount -L EMMC_SHARED /opt 2>/dev/null
}

stop() {
	umount /opt 2>/dev/null
}
