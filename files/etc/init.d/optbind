#!/bin/sh /etc/rc.common
# Bind the big shared eMMC partition onto /opt.
#
# ophub's installer lays the eMMC out as:
#   p1 EMMC_BOOT   (vfat)  -> /boot
#   p2 EMMC_ROOTFS1(btrfs) -> /mnt/mmcblk2p2   (spare rootfs)
#   p3 EMMC_ROOTFS2(btrfs) -> /               (running rootfs)
#   p4 EMMC_SHARED (btrfs) -> /mnt/mmcblk2p4  (all remaining space)
#
# /opt is therefore not a partition of its own: it is the shared partition.
# Docker keeps using /mnt/mmcblk2p4/docker, which is the same directory as
# /opt/docker after the bind.
START=99
STOP=10

start() {
	i=0
	while [ "$i" -lt 30 ]; do
		mountpoint -q /mnt/mmcblk2p4 && break
		sleep 1
		i=$((i + 1))
	done
	mountpoint -q /mnt/mmcblk2p4 || return 0
	mountpoint -q /opt && return 0
	mkdir -p /opt
	mount --bind /mnt/mmcblk2p4 /opt
}

stop() {
	mountpoint -q /opt && umount /opt
}
