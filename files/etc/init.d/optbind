#!/bin/sh /etc/rc.common
# /opt = the shared eMMC partition (p4, label EMMC_SHARED).
#
# Deliberately minimal: only a label based mount. No partition table edits, no
# filesystem grow, no bind mount and no symlink. Anything that rewrites the MBR
# at boot risks the Amlogic boot area, so it is not done here.
START=98
STOP=10

start() {
	i=0
	while [ "$i" -lt 30 ]; do
		blkid -L EMMC_SHARED >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done

	[ -n "$(blkid -L EMMC_SHARED 2>/dev/null)" ] || return 0

	mkdir -p /opt
	mountpoint -q /opt || mount -L EMMC_SHARED /opt 2>/dev/null

	# luci-app-amlogic hardcodes /mnt/<disk>p4 as its upload directory and its
	# update script cds there, so expose the mount under that name as well.
	if [ ! -L /mnt/mmcblk2p4 ]; then
		rm -rf /mnt/mmcblk2p4
		ln -s /opt /mnt/mmcblk2p4
	fi
}

stop() {
	umount /opt 2>/dev/null
}
